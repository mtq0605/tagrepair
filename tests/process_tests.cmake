set(fails 0)
function(check name cond_var)                 # cond_var = 调用处那个变量的名字(形参不能也叫 ok:会盖住它,永远为真)
    if(${cond_var})
        message(STATUS "[通过] ${name}")
    else()
        message(STATUS "[失败] ${name}")
        math(EXPR n "${fails} + 1")
        set(fails ${n} PARENT_SCOPE)
    endif()
endfunction()
# has(<放着输出的变量名> <要找的文字> <结果变量名>)。形参的名字故意起得不会和调用处的变量重名
function(has hv_text_var hv_needle hv_result_var)
    string(FIND "${${hv_text_var}}" "${hv_needle}" hv_at)
    if(hv_at EQUAL -1)
        set(${hv_result_var} FALSE PARENT_SCOPE)
    else()
        set(${hv_result_var} TRUE PARENT_SCOPE)
    endif()
endfunction()
# 一个文件夹里所有文件的"相对路径=SHA-256",排好序接成一串
function(folder_digest dir fd_result_var)
    file(GLOB_RECURSE all LIST_DIRECTORIES false RELATIVE "${dir}" "${dir}/*")
    list(SORT all)
    set(d "")
    foreach(f ${all})
        file(SHA256 "${dir}/${f}" h)
        string(APPEND d "${f}=${h}\n")
    endforeach()
    set(${fd_result_var} "${d}" PARENT_SCOPE)
endfunction()


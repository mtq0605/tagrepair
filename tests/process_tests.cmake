# ---- 9. 在(看不见的)控制台窗口里:进度条在同一行上重画;Ctrl+C、关窗口随时安全 ----
# tagrepair_tests pty 起一个伪控制台,不开任何可见的窗口。TAGREPAIR_TEST_DELAY_MS 让程序每处理一个文件之前等一下,好在确定的时刻按键
function(count_states dir cs_complete_var cs_repairable_var cs_temp_var)
    execute_process(COMMAND "${FOUR}" scan "${dir}" --json INPUT_FILE "${WORK}/empty.txt" OUTPUT_VARIABLE cs_out RESULT_VARIABLE cs_rc ENCODING UTF8)
    string(REGEX MATCH "\"complete\":([0-9]+),\"repairable\":([0-9]+)," cs_m "${cs_out}")
    set(${cs_complete_var} "${CMAKE_MATCH_1}" PARENT_SCOPE)
    set(${cs_repairable_var} "${CMAKE_MATCH_2}" PARENT_SCOPE)
    file(GLOB cs_tmp "${dir}/*.tmp")
    list(LENGTH cs_tmp cs_n)
    set(${cs_temp_var} "${cs_n}" PARENT_SCOPE)
endfunction()
